# Source database configuration (SQL Server)
# For Azure SQL Server, use format: server.database.windows.net
# For local SQL Server, use format: localhost\SQLEXPRESS or IP address
SOURCE_DRIVER={ODBC Driver 17 for SQL Server}
SOURCE_SERVER=your_server.database.windows.net
SOURCE_DATABASE=your_database
SOURCE_UID=your_username
SOURCE_PWD=your_password
SOURCE_PORT=1433
SOURCE_TRUSTED_CONNECTION=no

# Target database configuration (PostgreSQL)
# For local PostgreSQL, use localhost
# For cloud PostgreSQL, use the provided hostname
TARGET_HOST=localhost
TARGET_DATABASE=your_database
TARGET_USER=your_username
TARGET_PASSWORD=your_password
TARGET_PORT=5432

# ETL configuration
BATCH_SIZE=10000
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL 